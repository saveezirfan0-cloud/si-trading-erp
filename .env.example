# .env.local — Copy this file and fill in your Supabase project values.
# Defaults for the S.I Trading project are baked into src/lib/supabase.js,
# so these are only needed to point the app at a different project.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_publishable_or_anon_key
